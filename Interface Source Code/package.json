{
  "name": "floyd-stream-tool",
  "productName": "Floyd Stream Tool",
  "version": "2.1.1",
  "description": "Standalone esports scoreboard and OBS overlay controller",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server.js",
    "test": "node --test",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [],
  "author": {
    "name": "beto",
    "email": "robertofiore2712@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1.0.0",
    "express": "^5.2.1",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "40.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.takeitcheesy.floydstreamtool",
    "productName": "Floyd Stream Tool",
    "artifactName": "Floyd-Stream-Tool-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "NOTICE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/floyd.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TakeItCheesy10",
        "repo": "Floyd-Stream-Tool",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../Stream Tool",
        "to": "Stream Tool",
        "filter": [
          "Resources/**/*",
          "Smash Scoreboard.html",
          "Smash VS.html",
          "Street Fighter Scoreboard.html",
          "Street Fighter VS.html",
          "Game Scoreboard.html",
          "VS Screen.html",
          "!**/.floyd-state/**",
          "!**/*.psd",
          "!**/*.exe"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TakeItCheesy10/Floyd-Stream-Tool.git"
  }
}
